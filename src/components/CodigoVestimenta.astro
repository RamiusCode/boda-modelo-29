---
// src/components/CodigoVestimenta.astro
// Banda "Código de vestimenta" + etiqueta formal y nota del color blanco.
// ── DATOS EDITABLES ───────────────────────────────────────────
import FloresEsquinas from "./FloresEsquinas.astro";
const titulo = "CÓDIGO DE VESTIMENTA";
const etiqueta = "FORMAL";
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-vestimenta"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino">
        <span class="franja-filete arriba"></span>
        <span class="franja-filete abajo"></span>
    </div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="vestimenta" class="relative isolate overflow-hidden w-full px-7 pt-14 pb-24 text-center">
    <span
        class="icono icono-marron w-[88px] h-[88px] mx-auto"
        style="--ic: url('/imagenes/vestimenta.png')"
        aria-hidden="true"></span>

    <h3
        class="font-callingstone text-vino text-[clamp(0.7rem,3.55vw,0.96rem)] tracking-[0.14em] mt-5"
    >
        {etiqueta}
    </h3>

    <div class="adorno-vino mt-4" aria-hidden="true">
        <span></span><i></i><span></span>
    </div>

    <FloresEsquinas lados={["izq"]} ancho={120} />
</section>

<script>
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-vestimenta");
        if (franja) animarFranja(franja);

        const seccion = document.getElementById("vestimenta");
        if (seccion) animarEntrada(seccion.children, seccion);
    });
</script>

---
// src/components/NombresFlores.astro
// Arco vino con el anuncio, el monograma en un medallón dorado y los
// nombres de los novios, con ramos de rosas apoyados en las dos esquinas
// de la base. Es lo primero que se ve al abrir el sobre de la portada.
//
// Los nombres, el monograma y la fecha salen de data/evento.ts (los mismos
// que usa la portada). El nombre del invitado llega desde la página: la
// general (/) no lo pasa y esa parte directamente no se dibuja.
//
// Al abrir el sobre: el arco sube, sus dos filetes (crema y dorado) se
// dibujan subiendo por la cúpula, el medallón gira a su lugar, los ramos
// brotan desde las esquinas y caen unos pocos pétalos.
import Ramo from "./Ramo.astro";
import { evento } from "../data/evento";

interface Props {
    invitado?: string;
}

const { invitado } = Astro.props;
const { nombre1, nombre2, monograma, iniciales, anuncio, fechaCorta } = evento;
const frase = ["Te invitamos a celebrar", "el comienzo de nuestra historia"];
const textoInvitado = "Con mucho cariño, para";
---

<section id="nombres-flores" class="relative w-full flex justify-center pt-12 pb-16 px-5 overflow-hidden">
    <div id="petalos-nf" class="capa-petalos"></div>

    <div class="relative w-full max-w-[380px]">
        <div
            id="arco-novios"
            class="arco-luz arco-oro relative w-full bg-vino rounded-t-full shadow-[0_18px_40px_rgba(60,8,16,0.28)] flex flex-col items-center text-center px-6 pt-20 pb-28"
        >
            <div class="adorno-oro" aria-hidden="true">
                <span></span><i></i><span></span>
            </div>

            <p class="font-great-vibes text-crema text-[1.95rem] leading-[1.1] mt-4">
                {anuncio}
            </p>

            <div id="nf-medallon" class="medallon w-[78px] h-[78px] mt-6">
                <img
                    src={monograma}
                    alt={iniciales}
                    width="908"
                    height="702"
                    class="w-[50px] h-auto"
                />
            </div>

            <h1
                class="font-great-vibes text-crema text-[clamp(2.1rem,9.6vw,2.7rem)] leading-[1.2] mt-5 whitespace-nowrap nf-sombra"
            >
                {nombre1}<span class="mx-[0.22em]">&amp;</span>{nombre2}
            </h1>

            <div class="adorno-oro mt-3" aria-hidden="true">
                <span></span><i></i><span></span>
            </div>

            <p class="font-cormorant text-oro-claro text-[1rem] tracking-[0.34em] mt-3 [text-indent:0.34em]">
                {fechaCorta}
            </p>

            <p class="font-cormorant italic text-crema/85 text-[clamp(1rem,4.4vw,1.12rem)] leading-[1.5] mt-4">
                {frase.map((linea) => <span class="block whitespace-nowrap">{linea}</span>)}
            </p>

            {/* El nombre puede bajar de renglón: achicarlo hasta que entre
                en uno solo lo vuelve ilegible */}
            {
                invitado && (
                    <div class="nf-invitado mt-8">
                        <p class="font-cormorant italic text-crema/80 text-[0.95rem]">
                            {textoInvitado}
                        </p>
                        <p class="font-charm text-crema text-[clamp(1rem,4.6vw,1.2rem)] leading-[1.45] mt-1 max-w-[17rem] mx-auto">
                            {invitado}
                        </p>
                    </div>
                )
            }
        </div>

        <!-- Ramos en la base, apoyados sobre las esquinas del arco -->
        <div class="nf-ramo izq" aria-hidden="true">
            <Ramo id="ramo-nombres-izq" class="w-full h-auto ramo-sombra" />
        </div>
        <div class="nf-ramo der" aria-hidden="true">
            <Ramo id="ramo-nombres-der" espejo class="w-full h-auto ramo-sombra" />
        </div>
    </div>
</section>

<style>
    .nf-sombra {
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
    }

    /* Filetes dorados arriba y abajo del nombre del invitado */
    .nf-invitado {
        padding: 0.6rem 1.4rem;
        border-top: 1px solid rgba(214, 186, 132, 0.45);
        border-bottom: 1px solid rgba(214, 186, 132, 0.45);
    }

    .nf-ramo {
        position: absolute;
        bottom: -10%;
        width: 40%;
        pointer-events: none;
    }
    .nf-ramo.izq {
        left: -8%;
    }
    .nf-ramo.der {
        right: -8%;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { crearPetalos, menosMovimiento } from "../scripts/tres-d";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const arco = document.getElementById("arco-novios");
        const medallon = document.getElementById("nf-medallon");
        const capaPetalos = document.getElementById("petalos-nf");
        if (!arco) return;

        const ramos = arco.parentElement?.querySelectorAll(".nf-ramo") ?? [];
        const textos = Array.from(arco.children).filter((el) => el !== medallon);
        const quieto = menosMovimiento();

        // Armada en pausa: queda escondida mientras la portada la tapa y
        // arranca recién cuando el sobre se abre.
        const entrada = gsap.timeline({ paused: true });

        if (quieto) {
            entrada.fromTo(arco.parentElement, { opacity: 0 }, { opacity: 1, duration: 0.6 });
        } else {
            entrada
                .fromTo(
                    arco,
                    { opacity: 0, y: 40, scale: 0.96 },
                    { opacity: 1, y: 0, scale: 1, duration: 1.1, ease: "power3.out" },
                    0,
                )
                // Los dos filetes se dibujan subiendo por la cúpula
                .fromTo(
                    arco,
                    { "--filete": "100%" },
                    { "--filete": "0%", duration: 1.6, ease: "power2.inOut" },
                    0.3,
                )
                .fromTo(
                    textos,
                    { opacity: 0, y: 16, filter: "blur(5px)" },
                    {
                        opacity: 1,
                        y: 0,
                        filter: "blur(0px)",
                        duration: 0.9,
                        stagger: 0.12,
                        ease: "power2.out",
                    },
                    0.5,
                )
                .fromTo(
                    medallon,
                    { opacity: 0, scale: 0.5, rotation: -90 },
                    { opacity: 1, scale: 1, rotation: 0, duration: 1.1, ease: "back.out(1.6)" },
                    0.7,
                )
                // Los ramos brotan desde la esquina del arco
                .fromTo(
                    ramos,
                    {
                        opacity: 0,
                        scale: 0.55,
                        rotation: (i: number) => (i ? 14 : -14),
                        transformOrigin: (i: number) => (i ? "100% 100%" : "0% 100%"),
                    },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1.3,
                        stagger: 0.15,
                        ease: "back.out(1.4)",
                    },
                    0.9,
                )
                .add(() => {
                    // Un vaivén apenas perceptible, como movidos por el aire
                    ramos.forEach((r, i) =>
                        gsap.to(r, {
                            rotation: i ? -2 : 2,
                            duration: 3 + i * 0.6,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        }),
                    );
                });
        }

        let empezo = false;
        const empezar = () => {
            if (empezo) return;
            empezo = true;
            entrada.play();
            if (capaPetalos) crearPetalos(capaPetalos, 9);
        };

        // Con portada, entra al abrir el sobre; sin portada, al asomar.
        if (document.getElementById("portada-section")) {
            entrada.progress(0);
            window.addEventListener("portada:abierta", empezar, { once: true });
        } else {
            ScrollTrigger.create({ trigger: arco, start: "top 85%", once: true, onEnter: empezar });
        }
    });
</script>

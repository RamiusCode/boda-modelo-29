---
// src/components/Confirmar.astro
// Banda "Querida familia y amigos" + confirmación por WhatsApp.
// Los pases del invitado se muestran antes, en Pases.astro.
import FloresEsquinas from "./FloresEsquinas.astro";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "QUERIDA FAMILIA Y AMIGOS";

// Renglones cortos a propósito: con líneas largas el texto no podía crecer
// sin desbordar los 398px de ancho útil.
const parrafos = [
    [
        "Nos llena de felicidad poder",
        "compartir con ustedes este",
        "momento tan especial.",
    ],
    [
        "Con la esperanza de que hagamos",
        "de este día un recuerdo",
        "inolvidable.",
    ],
    [
        "Los esperamos con los corazones",
        "llenos de emoción, listos para",
        "celebrar con amor y crear",
        "memorias que permanezcan por siempre",
        
    ],
];

const despedida = "TE ESPERAMOS";

// WhatsApp de los novios (código de país + número, sin + ni espacios).
const whatsapp = "59170000000";
/*
   Un solo mensaje para todos, sirva la invitación para uno o para varios.
   Está escrito sin posesivo ("la asistencia", no "mi asistencia") y sin
   conjugar al invitado: el único verbo suyo es "confirmo", que va en
   singular siempre porque quien escribe el WhatsApp es una sola persona
   aunque venga acompañada. El "nos vemos" es invitado + novios, así que
   también es correcto en cualquier caso.

   Así no hay forma de que a alguien le llegue el texto en el número
   equivocado por olvidarse de ajustar los pases en index.astro.
*/
const mensaje =
    "Confirmo la asistencia a la boda de Alejandro y Valentina. Nos vemos el sábado 16 de octubre. ¡Será un placer acompañarlos!";

// Muestra para clientes: el botón no lleva a ningún lado. Para un evento
// real, volver a armarlo con el WhatsApp de los novios:
//   `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`
const enlace = "#";

const textoBoton = "CONFIRMAR ASISTENCIA";
// ──────────────────────────────────────────────────────────────
---

<section
    id="franja-confirmar"
    class="franja relative w-full py-8 px-7 overflow-hidden"
>
    <div class="franja-fondo absolute inset-0 bg-vino">
        <span class="franja-filete arriba"></span>
        <span class="franja-filete abajo"></span>
    </div>

    <h2
        class="franja-texto relative font-callingstone text-crema text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>
</section>

<section id="confirmar" class="relative isolate overflow-hidden w-full px-4 pt-14 pb-28 text-center">
    <div class="space-y-4">
        {
            parrafos.map((parrafo) => (
                <p class="font-balham text-marron text-[clamp(0.9rem,4.8vw,1.3rem)] leading-[1.5]">
                    {parrafo.map((linea) => (
                        <span class="block whitespace-nowrap">{linea}</span>
                    ))}
                </p>
            ))
        }
    </div>

    <a
        href={enlace}
        onclick="event.preventDefault()"
        class="block w-full max-w-[285px] mx-auto mt-7 px-6 py-3.5 rounded-[10px] bg-marron text-crema font-callingstone text-[clamp(0.7rem,3.1vw,0.84rem)] tracking-[0.18em] whitespace-nowrap shadow-[0_4px_12px_rgba(0,0,0,0.14)] transition-transform hover:scale-[1.04] boton-elegante"
    >
        {textoBoton}
    </a>

    <div class="adorno-vino mt-12" aria-hidden="true">
        <span></span><i></i><span></span>
    </div>

    <p
        class="font-balham text-marron text-[clamp(0.9rem,4.8vw,1.3rem)] leading-[1.5] mt-4"
    >
        {despedida}
    </p>

    <FloresEsquinas lados={["izq", "der"]} ancho={125} />
</section>

<script>
    import { animarEntrada, animarFranja } from "../scripts/animaciones";

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-confirmar");
        if (franja) animarFranja(franja);

        const seccion = document.getElementById("confirmar");
        if (seccion) animarEntrada(seccion.children, seccion);
    });
</script>
